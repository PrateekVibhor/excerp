# Copy this file to .env. Expo reads EXPO_PUBLIC_* values into the app when the JavaScript is bundled,
# so restart the dev server (npx expo start --clear) after changing them.
#
# "mock" uses the built-in sample articles; "api" reads articles from the pipeline's API.
EXPO_PUBLIC_DATA_SOURCE=mock
# Required when the data source is "api". Plain HTTP works in development; a store build needs HTTPS.
EXPO_PUBLIC_API_URL=
