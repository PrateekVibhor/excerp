# Copy this file to server/.env and fill in the values. server/.env is git-ignored.
# Never commit real keys, and never paste them into chat or logs.

# Tavily Search API key (https://app.tavily.com)
TAVILY_API_KEY=

# Nebius Token Factory API key, and the Nemotron model id to use
NEBIUS_API_KEY=
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Optional: a smaller, faster model for judging web pages in course builds. Unset, the main model judges.
# NEBIUS_JUDGE_MODEL=

# Postgres connection string. Local development uses the Homebrew Postgres on this Mac.
DATABASE_URL=postgres://localhost:5432/swipy

# Pipeline schedule and per-run cap
RUN_INTERVAL_MINUTES=1440
# Run once as soon as the worker starts (each restart then costs one run)
RUN_ON_START=true
MAX_PER_COMPANY=3

# Refresh list courses (a vetted source added or taken out of the reference library) every this many minutes, in the worker. OFF unless this is set (leave it out, or say "off"):
# only a reader's "Refresh now" checks a list. It does nothing, quietly, on a database that does not have the Plan 16 tables yet. A run with nothing changed makes no model calls.
# LIST_REFRESH_MINUTES=60

# Run the courses readers ask for, in the worker: look for queued work every this many seconds (a search for a course's sources, then its build). Leave it out and the
# worker does not touch courses. It does nothing, quietly, on a database that does not have the Plan 16 tables yet. Run only one worker against a database.
# COURSE_RUNNER_SECONDS=15
# The most search (Tavily) credits one source search may use, and one build may use. One course costs at most the two together. These are the defaults.
# COURSE_FIND_CREDITS=20
# COURSE_BUILD_CREDITS=40
# Docker Compose on the VM only: the database password (DATABASE_URL is set by docker-compose.yml)
POSTGRES_PASSWORD=

# Google sign-in: the Web application client id from the Google Cloud console (not a secret). Left empty, sign-in is off.
GOOGLE_WEB_CLIENT_ID=
# true: any verified Google account is approved and the allow-list is not enforced (a demo or hackathon). Leave off normally.
ALLOW_ANY_GOOGLE_ACCOUNT=false

# Behind the Caddy container only: docker-compose.yml sets TRUST_PROXY for the API. Leave it unset when the API is
# reached directly (local development), so X-Forwarded-For is never believed.
# TRUST_PROXY=172.30.0.10

# A file that gets one line per deleted account (the time and a hash, never the email or name), so a restore from a backup can
# delete them again. Put it on a volume that is not part of the database or its backups. Left unset, nothing is written.
# DELETION_LOG_PATH=/var/lib/excerp/deleted-accounts.log
